# ==========================================
# Shakkho FastAPI Backend — Supabase Config
# ==========================================

# 1. Supabase PostgreSQL Connection String
# For Supabase, find this in Project Settings -> Database -> Connection string.
# Recommended for serverless/APIs: Connection Pooling (Transaction Mode, Port 6543)
# Or Direct Connection (Port 5432)
SUPABASE_DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. Supabase API Credentials (Project Settings -> API)
# Used by backend services for Auth verification, Storage, and Supabase RPC
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Application Runtime
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
