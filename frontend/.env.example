# Server-only Upstash REST credentials. Never prefix these with NEXT_PUBLIC_.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=replace-with-write-token
KV_REST_API_READ_ONLY_TOKEN=replace-with-read-only-token

# Optional aliases supported by the same adapter:
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-write-token

# Optional: isolates the Redis key beyond Vercel's production/preview/development suffix.
# DLAS_KV_KEY=rjd:dlas:db:v1:production
