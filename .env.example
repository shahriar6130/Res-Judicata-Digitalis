# ==============================================================================
# Shakkho — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Database (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain from Supabase Project Settings -> Database -> Connection string (URI)
# Use Transaction Mode connection pooling (Port 6543) or Direct (Port 5432)
SUPABASE_DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Supabase Project API Credentials
# ------------------------------------------------------------------------------
# Obtain from Supabase Project Settings -> API
# Note: Used strictly by backend services; never exposed on client-side frontend
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Service Runtimes
# ------------------------------------------------------------------------------
ENVIRONMENT=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
